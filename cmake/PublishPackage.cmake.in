cmake_minimum_required(VERSION 3.20)

# CPack has already assembled the complete ZIP using install() rules.
set(dist "@CMAKE_CURRENT_SOURCE_DIR@/dist")
set(package "${dist}/I2C_MemoryMap")
set(staging "${dist}/.I2C_MemoryMap.new")
set(previous "${dist}/.I2C_MemoryMap.previous")
set(zip "${dist}/I2C_MemoryMap.zip")

if(WIN32)
    execute_process(COMMAND tasklist /FI "IMAGENAME eq i2c_memorymap.exe" /FO CSV /NH
        RESULT_VARIABLE result OUTPUT_VARIABLE processes ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Could not check running applications: ${error}")
    endif()
    string(TOLOWER "${processes}" processes)
    if(processes MATCHES "i2c_memorymap\\.exe")
        message(FATAL_ERROR "Close i2c_memorymap.exe before packaging. The existing distribution has not been changed.")
    endif()
endif()

# All replacement/removal paths must be direct children of this project's dist directory.
foreach(path IN ITEMS "${package}" "${staging}" "${previous}" "${zip}")
    get_filename_component(parent "${path}" DIRECTORY)
    if(NOT parent STREQUAL dist OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Unsafe distribution path: ${path}")
    endif()
endforeach()
if(IS_SYMLINK "${dist}")
    message(FATAL_ERROR "Distribution directory must not be a link: ${dist}")
endif()
file(MAKE_DIRECTORY "${dist}")
file(LOCK "${dist}/.package.lock" GUARD PROCESS TIMEOUT 60)
if(EXISTS "${previous}")
    message(FATAL_ERROR "Previous package backup exists; inspect it before retrying: ${previous}")
endif()
file(REMOVE_RECURSE "${staging}")
list(GET CPACK_PACKAGE_FILES 0 archive)
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${staging}")

# A locked distribution directory must fail before removing the old package.
if(EXISTS "${package}")
    execute_process(COMMAND "@CMAKE_COMMAND@" -E rename "${package}" "${previous}"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Close the packaged app before packaging: ${error}")
    endif()
endif()
execute_process(COMMAND "@CMAKE_COMMAND@" -E rename "${staging}" "${package}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    if(EXISTS "${previous}")
        file(RENAME "${previous}" "${package}")
    endif()
    message(FATAL_ERROR "Could not publish package: ${error}")
endif()
configure_file("${archive}" "${zip}" COPYONLY)
file(REMOVE_RECURSE "${previous}")
message(STATUS "Distribution: ${package} and ${zip}")
